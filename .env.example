# Public (frontend — publishable only)
# Next.js (`web/`): skopiuj do `web/.env.local`
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."

# Legacy Alpine (`src/js/config.js`) — trzymaj zsynchronizowane z powyższym.
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="sb_publishable_..."

# Local CLI / migrations only — NEVER commit real values; NEVER put in frontend
DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"
SUPABASE_ACCESS_TOKEN="sbp_..."

# Wrangler (Next Worker smart-senior-web). Local or CI only — NEVER Supabase Edge secrets.
# CLOUDFLARE_API_TOKEN=

# Edge Functions secrets (set via `supabase secrets set`, never in Cloudflare front)
# SUPABASE_SERVICE_ROLE_KEY is injected automatically on hosted Edge; set locally if needed.
# Polar AccessLink — wycofane z MVP (ADR-012). Nie ustawiaj sekretów Polar.


